# Ingestion (FR-1.1): "ring-api" | "ring-simulator" | "synthetic"
QS_INGESTION_MODE=synthetic

# Demo mode (FR-6.2): replays a scripted absence-break scenario instead of
# calling ingestion at all. Set to "false" once real/synthetic history is wired up.
QS_DEMO_MODE=true

# Baseline / detection tuning (FR-6.1)
QS_TIMEZONE=America/New_York
QS_ROLLING_WINDOW_DAYS=21
QS_CONFIRMATION_PERIOD_MINUTES=20
QS_QUIET_HOURS_START=22:00
QS_QUIET_HOURS_END=07:00
QS_TOLERANCE=balanced

# Ring developer credentials (Days 1-3 spike, see docs/PRD.md §10 and docs/SPIKE_DAY1-3.md)
# Fastest path: RING_ACCESS_TOKEN alone, from the Playground:
# https://developer.amazon.com/ring/console/playground (token expires in ~30 min)
RING_ACCESS_TOKEN=

# Production OAuth path instead of the line above (do not set both):
# https://developer.amazon.com/docs/ring/authentication.html
RING_CLIENT_ID=
RING_CLIENT_SECRET=
RING_REFRESH_TOKEN=

# Optional: require this bearer token on incoming Ring webhooks (src/app/api/webhook/ring)
RING_WEBHOOK_SECRET=

# AWS (Bedrock alert composer + SES email leg)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
QS_BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
QS_ALERT_FROM_EMAIL=alerts@quietsignal.example
